#!/usr/bin/env python3
"""stdio MCP server that forwards JSON-RPC messages to Sure's POST /mcp endpoint."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

SURE_DIR = Path(__file__).resolve().parent.parent
SURE_ENV = SURE_DIR / ".env"


def get_token() -> str:
    token = os.environ.get("SURE_MCP_TOKEN") or os.environ.get("MCP_API_TOKEN")
    if token:
        return token
    if SURE_ENV.exists():
        for line in SURE_ENV.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == "MCP_API_TOKEN":
                return v.strip().strip("'\"")
    return ""


def get_url() -> str:
    return os.environ.get("SURE_MCP_URL", "http://127.0.0.1:3000/mcp")


def post(msg: dict, url: str, token: str) -> dict | None:
    req = urllib.request.Request(
        url,
        data=json.dumps(msg).encode("utf-8"),
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Authorization": f"Bearer {token}",
        },
    )
    with urllib.request.urlopen(req, timeout=120) as resp:
        body = resp.read()
    return json.loads(body) if body.strip() else None


def rpc_error(request_id, code: int, message: str) -> dict:
    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}


def main() -> None:
    token = ""
    url = get_url()
    out = sys.stdout
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            msg = json.loads(raw)
        except json.JSONDecodeError:
            out.write(json.dumps(rpc_error(None, -32700, "Parse error")) + "\n")
            out.flush()
            continue
        if (
            not isinstance(msg, dict)
            or msg.get("jsonrpc") != "2.0"
            or not isinstance(msg.get("method"), str)
            or not msg["method"]
            or ("id" in msg and type(msg["id"]) not in (str, int))
            or ("params" in msg and not isinstance(msg["params"], (dict, list)))
        ):
            out.write(json.dumps(rpc_error(None, -32600, "Invalid Request")) + "\n")
            out.flush()
            continue
        is_notification = "id" not in msg
        try:
            if msg.get("method") == "ping":
                reply = {"jsonrpc": "2.0", "id": msg.get("id"), "result": {}}
            else:
                if not token:
                    token = get_token()
                if not token:
                    raise RuntimeError("MCP_API_TOKEN not found in environment or Sure .env")
                reply = post(msg, url, token)
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                message = (
                    f"Sure MCP authentication failed (HTTP {e.code}). "
                    "Check SURE_MCP_TOKEN/MCP_API_TOKEN and the server's MCP_USER_EMAIL or OAuth permissions."
                )
            else:
                message = f"Sure MCP endpoint returned HTTP {e.code}. Check the Rails server logs."
            e.close()
            reply = rpc_error(msg.get("id"), -32000, message)
        except urllib.error.URLError:
            reply = rpc_error(msg.get("id"), -32000, "Cannot connect to Sure MCP. Check SURE_MCP_URL and that the Rails server is reachable.")
        except TimeoutError:
            reply = rpc_error(msg.get("id"), -32000, "Sure MCP request timed out. Check the Rails server logs.")
        except Exception as e:
            reply = rpc_error(msg.get("id"), -32000, f"Sure MCP bridge error: {e}")
        if is_notification or reply is None:
            continue
        out.write(json.dumps(reply) + "\n")
        out.flush()


if __name__ == "__main__":
    main()
